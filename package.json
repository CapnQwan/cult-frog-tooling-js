{
  "name": "@cult-frog/tooling",
  "version": "0.0.0",
  "description": "Shared TypeScript, Biome, and build config used across Cult Frog packages — a single source of truth so every package builds, lints, and tests the same way.",
  "license": "MIT",
  "author": "Quin Partridge",
  "keywords": [
    "typescript",
    "biome",
    "vitest",
    "config",
    "tooling"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CapnQwan/cult-frog-tooling-js.git"
  },
  "bugs": {
    "url": "https://github.com/CapnQwan/cult-frog-tooling-js/issues"
  },
  "homepage": "https://github.com/CapnQwan/cult-frog-tooling-js#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "tsconfig",
    "biome",
    "vitest"
  ],
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/build.json": "./tsconfig/build.json",
    "./biome/base": "./biome/base.jsonc",
    "./vitest/base": "./vitest/base.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "check": "biome check . --error-on-warnings",
    "check:ci": "biome ci . --error-on-warnings",
    "fix": "biome check . --write",
    "build": "echo 'no build step - @cult-frog/tooling ships raw config files'",
    "prepublishOnly": "pnpm check:ci && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.33.4",
  "lint-staged": {
    "*.{ts,tsx,js,json,jsonc}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.20.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
